rules_version = '2';
// Rata & Smudge: each business is one private document, businesses/{bid}.
// Only Google accounts listed in its "members" can read or change it; one business can never see another's.
// New businesses are invite-only: an admin adds invites/{email}, and only that account can create one.
// Admins are listed as documents admins/{email}, created by hand in the Firebase console. Nobody can
// create, change or delete them from the app, and no admin address is written in this code.
//
// Roles:  main owner = the "owner" field: the person who created the business. Can never be removed,
//                      demoted or replaced by anyone else. Only the main owner can delete the business,
//                      and only the main owner can hand the role over, to the co-owner (who then
//                      becomes the protected main owner, and the old main owner becomes co-owner).
//         co-owner   = the one other person in "owners" (at most 2 owners). Everything the main owner can
//                      do except change or remove the main owner, or delete the business. The main owner
//                      can remove the co-owner, and the co-owner can step down.
//         manager = roles[email] == 'manager'. Everything except removing people, changing roles or deleting.
//         helper  = any other member (the safe default). Can see products and deals, open and close a selling
//                   day, and record sales as themselves. Cannot change prices, products, settings or past sales.
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(email())); }
    function invited() { return signedIn() && exists(/databases/$(database)/documents/invites/$(email())); }
    function biz(bid) { return get(/databases/$(database)/documents/businesses/$(bid)).data; }
    function isMember(bid) { return signedIn() && email() in biz(bid).members; }
    function roleIn(b) { return email() in b.owners ? 'owner' : b.get('roles', {}).get(email(), 'helper'); }
    function canManage(bid) { return isMember(bid) && roleIn(biz(bid)) in ['owner', 'manager']; }

    match /admins/{adminEmail} {
      allow read: if signedIn() && email() == adminEmail;      // lets the app ask "am I an admin?"
      allow write: if false;                                    // console only
    }

    match /invites/{inviteEmail} {
      allow read: if isAdmin() || (signedIn() && email() == inviteEmail);
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && email() == inviteEmail);
    }

    match /businesses/{bid} {
      allow read: if signedIn() && email() in resource.data.members;

      // a new business starts with just the person creating it, as owner, and nothing else in it
      allow create: if (isAdmin() || invited())
                    && request.resource.data.members == [email()]
                    && request.resource.data.owner == email()
                    && request.resource.data.owners == [email()]
                    && request.resource.data.get('roles', {}) == {};

      // Owners and managers change settings. The main owner never changes and always stays a member and
      // an owner; at most 2 owners, all of them members. Owners can change people and roles (but the main
      // owner is protected above); a manager can add people (as manager or helper) but not change or remove anyone.
      allow update: if signedIn() && email() in resource.data.members
                    && roleIn(resource.data) in ['owner', 'manager']
                    && (request.resource.data.owner == resource.data.owner
                        || (email() == resource.data.owner && request.resource.data.owner in resource.data.owners))
                    && request.resource.data.owner in request.resource.data.owners
                    && request.resource.data.owners is list
                    && request.resource.data.owners.size() >= 1 && request.resource.data.owners.size() <= 2
                    && request.resource.data.members.hasAll(request.resource.data.owners)
                    && request.resource.data.members.size() <= 20
                    && request.resource.data.get('roles', {}).values().hasOnly(['manager', 'helper'])
                    // only an owner can let managers see recipes and costs
                    && (roleIn(resource.data) == 'owner'
                        || request.resource.data.get('settings', {}).get('mgrCosts', false) == resource.data.get('settings', {}).get('mgrCosts', false))
                    && (roleIn(resource.data) == 'owner'
                        || (request.resource.data.owners == resource.data.owners
                            && request.resource.data.members.hasAll(resource.data.members)
                            && request.resource.data.get('roles', {}).diff(resource.data.get('roles', {})).changedKeys().size() == 0
                            && request.resource.data.get('roles', {}).diff(resource.data.get('roles', {})).removedKeys().size() == 0));
      allow delete: if signedIn() && email() == resource.data.owner;

      // Shared business data. Owners and managers read and change these; helpers read only what the till
      // and the day's work need (products, deals, selling days, sales, places, calendar, brew plan, stock),
      // and can never change a price.
      function managed() { return ['inputs', 'products', 'deals', 'sessions', 'sales', 'batches', 'orders',
                                   'places', 'events', 'plans', 'ideas', 'costs', 'prices', 'fuel', 'xero']; }
      function everyone() { return ['products', 'deals', 'sessions', 'sales', 'places', 'events', 'plans']; }
      match /{col}/{id} {
        allow read: if (canManage(bid) && col in managed().concat(['stockmoves', 'shopping', 'todos', 'voicenotes', 'ai']))
                    || (isMember(bid) && col in everyone());
        allow write: if canManage(bid) && col in managed();
      }
      // Recipes and staff pay rates: owners only (recipes are the business's secret; pay is private).
      // An owner can let managers read the recipes (to see costs and plan brews); only owners change them.
      match /recipes/{id} {
        allow read: if isMember(bid) && roleIn(biz(bid)) == 'owner';
        allow write: if isMember(bid) && roleIn(biz(bid)) == 'owner';
      }
      match /pay/{id} {
        allow read, write: if isMember(bid) && roleIn(biz(bid)) == 'owner';
      }
      // the owners' time clock and helpers' hours: owners only
      match /clock/{id} {
        allow read, write: if isMember(bid) && roleIn(biz(bid)) == 'owner';
      }
      // Stock movements (made, packed for a market, sold, returned, fixed). Everyone sees stock, so the till
      // can hint "sold out". Anyone can add a movement in their own name; a helper's fix must carry the
      // owner or manager who approved it with their PIN. Movements are never edited or deleted.
      match /stockmoves/{id} {
        allow read: if isMember(bid);
        allow create: if isMember(bid) && request.resource.data.by == email() && request.resource.data.at is number
                      && request.resource.data.qty is number
                      && (canManage(bid) || request.resource.data.get('kind', '') in ['sold', 'packed', 'returned']
                          || request.resource.data.get('approvedBy', '') is string && request.resource.data.get('approvedBy', '') != '');
      }
      // To-dos: owners and managers see and change all of them; a helper sees only their own, can add one
      // for themselves and tick their own off, but cannot hand it to someone else.
      match /todos/{id} {
        allow read: if canManage(bid) || (isMember(bid) && resource.data.get('who', '') == email());
        allow create: if canManage(bid) || (isMember(bid) && request.resource.data.get('who', '') == email());
        allow update: if canManage(bid) || (isMember(bid) && resource.data.get('who', '') == email()
                                            && request.resource.data.get('who', '') == email());
        allow delete: if canManage(bid);
      }
      // Shopping list: everyone can see it, add to it and tick things off; only owners and managers remove items.
      match /shopping/{id} {
        allow read, create, update: if isMember(bid);
        allow delete: if canManage(bid) || (isMember(bid) && resource.data.get('by', '') == email());
      }
      // Voice notes: you add notes in your own name and see and settle your own (owners and managers see all).
      // The business helper reads them and writes the drafts back (it works outside these rules).
      match /voicenotes/{id} {
        allow read: if canManage(bid) || (isMember(bid) && resource.data.get('by', '') == email());
        allow create: if isMember(bid) && request.resource.data.by == email() && request.resource.data.at is number;
        allow update: if isMember(bid) && resource.data.by == email() && request.resource.data.by == email();
        allow delete: if canManage(bid) || (isMember(bid) && resource.data.get('by', '') == email());
      }
      // A helper asking an owner or manager to open a market. You ask in your own name and see only your own;
      // owners and managers see all and answer them. The person who asked can only cancel or mark it opened:
      // never approve it themselves.
      match /asks/{id} {
        allow read: if canManage(bid) || (isMember(bid) && resource.data.get('by', '') == email());
        allow create: if isMember(bid) && request.resource.data.by == email() && request.resource.data.status == 'waiting'
                      && request.resource.data.at is number && request.resource.data.get('decidedBy', '') == '';
        allow update: if canManage(bid)
                      || (isMember(bid) && resource.data.by == email() && request.resource.data.by == email()
                          && request.resource.data.get('decidedBy', '') == resource.data.get('decidedBy', '')
                          && (request.resource.data.status == resource.data.status
                              || (resource.data.status == 'waiting' && request.resource.data.status == 'cancelled')));
        allow delete: if canManage(bid);
      }
      // The app health log: any member's device notes a fault in their own name; only owners read or clear it.
      match /errors/{id} {
        allow create: if isMember(bid) && request.resource.data.by == email() && request.resource.data.msg is string && request.resource.data.msg.size() <= 300;
        allow read, delete: if isMember(bid) && roleIn(biz(bid)) == 'owner';
      }
      // This device's push-notification address, one per person; the business helper sends the alerts.
      match /devices/{who} {
        allow read, write: if isMember(bid) && who == email();
      }
      // Personal PINs: one document per owner or manager, holding only a salted hash of their PIN.
      // Helpers can't read them, so a helper can't try to work a PIN out. You set only your own;
      // an owner can remove anyone's (e.g. someone who has left).
      match /pins/{who} {
        allow read: if canManage(bid);
        allow create, update: if canManage(bid) && who == email() && request.resource.data.hash is string;
        allow delete: if canManage(bid) && (who == email() || roleIn(biz(bid)) == 'owner');
      }
      // Approvals log: who approved what, and when. Anyone in the business can add an entry for an action
      // on their device; only owners and managers can read it; nobody can change an entry, and only everyday
      // owner entries can be tidied away (below).
      match /audit/{id} {
        allow read: if canManage(bid);
        allow create: if isMember(bid) && request.resource.data.by == email() && request.resource.data.at is number;
        // the only thing ever removed: an owner tidying away everyday entries approved by an owner
        // (seeing the takings or sales, opening Setup, leaving till mode, ending or closing the day)
        allow delete: if isMember(bid) && roleIn(biz(bid)) == 'owner'
                      && resource.data.action in ['see the takings', 'see the sales', 'open Setup', 'leave till mode', 'end the day', 'close the day']
                      && resource.data.approver in biz(bid).get('owners', []);
      }
      // Emailed GST receipts: anyone selling can ask for a receipt for a sale to be emailed. The request only
      // names the sale and the address; the Google helper script builds the receipt itself from the saved
      // sale, sends it from the business Gmail and marks it sent (the helper works outside these rules).
      match /receipts/{id} {
        allow read: if canManage(bid);
        allow create: if isMember(bid) && request.resource.data.by == email() && request.resource.data.status == 'queued'
                      && request.resource.data.saleId is string && request.resource.data.to is string
                      && request.resource.data.to.size() < 120 && request.resource.data.to.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$');
      }
      // Customer contacts: one entry each time an email address is collected (with a receipt), recording
      // whether the customer chose to join the Loyalty programme and the exact wording they agreed to.
      // Entries are never edited: leaving the programme is a new entry. Owners and managers can read them;
      // only an owner can delete (a customer asking to be forgotten).
      match /contacts/{id} {
        allow read: if canManage(bid);
        allow create: if isMember(bid) && request.resource.data.by == email() && request.resource.data.loyalty is bool
                      && request.resource.data.email is string && request.resource.data.email.size() < 120
                      && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$') && request.resource.data.at is number;
        allow delete: if signedIn() && roleIn(biz(bid)) == 'owner' && isMember(bid);
      }
      // helpers: open and close a selling day, and record (never edit or delete) their own sales
      match /sessions/{id} {
        allow create, update: if isMember(bid) && request.resource.data.openedBy is string;
      }
      match /sales/{id} {
        allow create: if isMember(bid) && request.resource.data.by == email() && request.resource.data.get('voided', false) == false;
        // "Undo last sale": the person who took it can remove it within 10 minutes (the app allows 1 minute;
        // the extra time covers a sale undone with no signal and sent later). After that, only a void by the owner.
        allow delete: if isMember(bid) && resource.data.by == email() && request.time.toMillis() < resource.data.at + 600000;
      }
    }
  }
}
