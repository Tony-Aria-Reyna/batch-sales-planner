rules_version = '2';
// Rata & Smudge: each business is one private document, businesses/{bid}.
// Only Google accounts listed in its "members" can read or change it; one business can never see another's.
// New businesses are invite-only: an admin adds invites/{email}, and only that account can create one.
// Admins are listed as documents admins/{email}, created by hand in the Firebase console. Nobody can
// create, change or delete them from the app, and no admin address is written in this code.
//
// Roles:  main owner = the "owner" field: the person who created the business. Can never be removed,
//                      demoted or replaced by anyone else. Only the main owner can delete the business,
//                      and only the main owner can hand the role over, to the co-owner (who then
//                      becomes the protected main owner, and the old main owner becomes co-owner).
//         co-owner   = the one other person in "owners" (at most 2 owners). Everything the main owner can
//                      do except change or remove the main owner, or delete the business. The main owner
//                      can remove the co-owner, and the co-owner can step down.
//         manager = roles[email] == 'manager'. Everything except removing people, changing roles or deleting.
//         helper  = any other member (the safe default). Can see products and deals, open and close a selling
//                   day, and record sales as themselves. Cannot change prices, products, settings or past sales.
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(email())); }
    function invited() { return signedIn() && exists(/databases/$(database)/documents/invites/$(email())); }
    function biz(bid) { return get(/databases/$(database)/documents/businesses/$(bid)).data; }
    function isMember(bid) { return signedIn() && email() in biz(bid).members; }
    function roleIn(b) { return email() in b.owners ? 'owner' : b.get('roles', {}).get(email(), 'helper'); }
    function canManage(bid) { return isMember(bid) && roleIn(biz(bid)) in ['owner', 'manager']; }

    match /admins/{adminEmail} {
      allow read: if signedIn() && email() == adminEmail;      // lets the app ask "am I an admin?"
      allow write: if false;                                    // console only
    }

    match /invites/{inviteEmail} {
      allow read: if isAdmin() || (signedIn() && email() == inviteEmail);
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && email() == inviteEmail);
    }

    match /businesses/{bid} {
      allow read: if signedIn() && email() in resource.data.members;

      // a new business starts with just the person creating it, as owner, and nothing else in it
      allow create: if (isAdmin() || invited())
                    && request.resource.data.members == [email()]
                    && request.resource.data.owner == email()
                    && request.resource.data.owners == [email()]
                    && request.resource.data.get('roles', {}) == {};

      // Owners and managers change settings. The main owner never changes and always stays a member and
      // an owner; at most 2 owners, all of them members. Owners can change people and roles (but the main
      // owner is protected above); a manager can add people (as manager or helper) but not change or remove anyone.
      allow update: if signedIn() && email() in resource.data.members
                    && roleIn(resource.data) in ['owner', 'manager']
                    && (request.resource.data.owner == resource.data.owner
                        || (email() == resource.data.owner && request.resource.data.owner in resource.data.owners))
                    && request.resource.data.owner in request.resource.data.owners
                    && request.resource.data.owners is list
                    && request.resource.data.owners.size() >= 1 && request.resource.data.owners.size() <= 2
                    && request.resource.data.members.hasAll(request.resource.data.owners)
                    && request.resource.data.members.size() <= 20
                    && request.resource.data.get('roles', {}).values().hasOnly(['manager', 'helper'])
                    && (roleIn(resource.data) == 'owner'
                        || (request.resource.data.owners == resource.data.owners
                            && request.resource.data.members.hasAll(resource.data.members)
                            && request.resource.data.get('roles', {}).diff(resource.data.get('roles', {})).changedKeys().size() == 0
                            && request.resource.data.get('roles', {}).diff(resource.data.get('roles', {})).removedKeys().size() == 0));
      allow delete: if signedIn() && email() == resource.data.owner;

      // set-up data: owners and managers can read and change everything; helpers can read only what the
      // till needs (products, deals, selling days, sales), and can never change a price
      match /{col}/{id} {
        allow read: if (canManage(bid) && col in ['inputs', 'recipes', 'products', 'deals', 'sessions', 'sales', 'batches', 'orders', 'todos'])
                    || (isMember(bid) && col in ['products', 'deals', 'sessions', 'sales']);   // helpers: just what the till needs
        allow write: if canManage(bid) && col in ['inputs', 'recipes', 'products', 'deals', 'sessions', 'sales', 'batches', 'orders', 'todos'];
      }
      // Personal PINs: one document per owner or manager, holding only a salted hash of their PIN.
      // Helpers can't read them, so a helper can't try to work a PIN out. You set only your own;
      // an owner can remove anyone's (e.g. someone who has left).
      match /pins/{who} {
        allow read: if canManage(bid);
        allow create, update: if canManage(bid) && who == email() && request.resource.data.hash is string;
        allow delete: if canManage(bid) && (who == email() || roleIn(biz(bid)) == 'owner');
      }
      // Approvals log: who approved what, and when. Anyone in the business can add an entry for an action
      // on their device; only owners and managers can read it; nobody can change or delete an entry.
      match /audit/{id} {
        allow read: if canManage(bid);
        allow create: if isMember(bid) && request.resource.data.by == email() && request.resource.data.at is number;
      }
      // helpers: open and close a selling day, and record (never edit or delete) their own sales
      match /sessions/{id} {
        allow create, update: if isMember(bid) && request.resource.data.openedBy is string;
      }
      match /sales/{id} {
        allow create: if isMember(bid) && request.resource.data.by == email() && request.resource.data.get('voided', false) == false;
        // "Undo last sale": the person who took it can remove it within 10 minutes (the app allows 1 minute;
        // the extra time covers a sale undone with no signal and sent later). After that, only a void by the owner.
        allow delete: if isMember(bid) && resource.data.by == email() && request.time.toMillis() < resource.data.at + 600000;
      }
    }
  }
}
